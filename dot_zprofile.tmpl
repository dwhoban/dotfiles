# Login shell setup for zsh.
# Shared environment, PATH, and aliases live in ~/.config/shell.

# (N) = nullglob: skip the loop entirely if the dir is empty
for _script in "$HOME"/.config/shell/*.sh(N); do
    . "$_script"
done

# Work configuration (cloned by chezmoi on work machines)
for _script in "$HOME"/.config/work/shell/*.sh(N); do
    . "$_script"
done
unset _script

# Keep zsh config in ~/.config/zsh
export ZDOTDIR="${XDG_CONFIG_HOME}/zsh"
