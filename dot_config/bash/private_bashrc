# Interactive bash config.
# Sourced from ~/.profile for login shells.

# Programmable completions (Homebrew bash-completion@2, needs Homebrew bash >= 4.2)
if [ -f /opt/homebrew/etc/profile.d/bash_completion.sh ]; then
    . /opt/homebrew/etc/profile.d/bash_completion.sh
fi

# fzf completion and key bindings (Homebrew)
if [ -f /opt/homebrew/opt/fzf/shell/completion.bash ]; then
    source /opt/homebrew/opt/fzf/shell/completion.bash
fi
if [ -f /opt/homebrew/opt/fzf/shell/key-bindings.bash ]; then
    source /opt/homebrew/opt/fzf/shell/key-bindings.bash
fi

# Prefer git's own subcommand completion over fzf's path completion for git
_completion_loader git 2>/dev/null && complete -o bashdefault -o default -o nospace -F __git_main git 2>/dev/null

if command -v zoxide &>/dev/null; then
    eval "$(zoxide init bash)"
fi

if command -v starship &>/dev/null; then
    # Starship prompt
    eval "$(starship init bash)"

    export STARSHIP_LOG=error

    function set_win_title() {
        echo -ne "\033]0; $(basename "$PWD") \007"
    }
    # Bash equivalent of starship_precmd_user_func
    PROMPT_COMMAND="set_win_title${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
fi

if command -v atuin &>/dev/null; then
    eval "$(atuin init bash)"
fi
