{
  "$schema": "https://opencode.ai/config.json",
  "shell": "/opt/homebrew/bin/zsh",
  "plugin": [
    "/Users/dwh/.config/opencode/vendor/i-have-adhd/.opencode/plugins/i-have-adhd.mjs"
  ],
  "permission": {
    "external_directory": {
      "/tmp/**": "allow",
      "/private/tmp/**": "allow",
      "/var/folders/**": "allow"
    }
  },
  "disabled_providers": [
    "opencode"
  ],
  "mcp": {
    "1password": {
      "type": "local",
      "command": [
        "1password-mcp"
      ]
    },
    "agent-browser": {
      "type": "local",
      "command": [
        "agent-browser",
        "mcp",
        "--tools",
        "all"
      ]
    }
  },
}
