{{ if and (eq .chezmoi.os "darwin") (lookPath "brew") -}}
#!/bin/bash
set -euo pipefail

export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

if [ ! -d "/Applications/1Password.app" ]; then
  brew install --cask 1password
fi
if ! command -v op >/dev/null 2>&1; then
  brew install --cask 1password-cli
fi

cli_ready() {
  [ -n "$(op account list --format json 2>/dev/null)" ]
}
if cli_ready; then
  exit 0
fi

open -a 1Password
echo "Sign in to 1Password, then enable Settings → Developer → 'Integrate with 1Password CLI'."

while ! cli_ready; do
  if [ ! -e /dev/tty ]; then
    echo "No terminal available; skipping 1Password setup prompt." >&2
    exit 0
  fi
  read -r -p "Press Enter once 1Password is set up (Ctrl-C to finish later)... " < /dev/tty || true
done
{{ end -}}
